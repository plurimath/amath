  # ---- measurement uncertainty (plurimath#493) ----
  # ustd(y, u) / ustd(y(d)) / uexp(y, U, k[, p]) / ucov(y, lo, hi, p[, kind]),
  # each with an optional last "unitsml(...)" argument; tree contract in
  # plurimath docs/uncertainty-asciimath-tree.md. `uncertainty` is the first
  # alternative of symbol_text_or_integer, so a well-formed `uexp(...)` no
  # longer reads as `u exp(...)`. A call that is not a well-formed uncertainty form (e.g. uexp
  # with two arguments, or uexp(x)) fails here and falls back to the
  # ordinary alternatives, so it parses as letters exactly as before.
  # Numbers always use a full stop, whatever the decimal marker.
  unc_number = 1*digit ["." 1*digit]
  unc_value = (["-"] unc_number) as value
  unc_sep = *space "," *space
  unc_unit = unc_sep "\"unitsml(" ((1*(!(")\"") any_char)) as literal / "" as empty_list) as unit ")\""
  unc_open = "(" *space
  unc_close = *space ")"
  # Shared exponents apply only to the grouped measured fields (or to a
  # concise value), never to dimensionless coverage factors/probabilities.
  # Preserve each mantissa and exponent as original source slices; the
  # consuming reader performs the exact decimal-place shift without floats.
  unc_shared_exponent = "e" (["+" / "-"] 1*digit) as shared_exponent
  unc_measured_pair = unc_value unc_sep (unc_number) as magnitude
  unc_scaled_pair = unc_open unc_measured_pair unc_close unc_shared_exponent
  unc_measured_interval = unc_value unc_sep (unc_number) as lower unc_sep (unc_number) as upper
  unc_scaled_interval = unc_open unc_measured_interval unc_close unc_shared_exponent
  unc_standard = unc_scaled_pair / unc_value (unc_sep (unc_number) as magnitude / "(" (1*digit) as concise_digits ")" [unc_shared_exponent])
  uncertainty = (uncertainty_std / uncertainty_exp / uncertainty_cov) as uncertainty
  uncertainty_std = ("ustd") as uncertainty_class unc_open unc_standard [unc_unit] unc_close
  uncertainty_exp = ("uexp") as uncertainty_class unc_open (unc_scaled_pair / unc_measured_pair) unc_sep (unc_number) as coverage_factor [unc_sep (unc_number) as coverage_probability] [unc_unit] unc_close
  uncertainty_cov = ("ucov") as uncertainty_class unc_open (unc_scaled_interval / unc_measured_interval) unc_sep (unc_number) as coverage_probability [unc_sep ("shortest" / "symmetric") as interval_kind] [unc_unit] unc_close

  # ---- helpers (no Parslet rule of their own) ----
  digit = %x30-39
  ascii_letter = %x41-5A / %x61-7A
  # match(/(?<!\/)\/(?!\/)/), see the notes above.
  frac_slash = "/" !"/"
  # match((?-mix:[^\[{(\\\/@;:.,'"|\]})0-9a-zA-Z\-><$%^&*_=+!`~\s?\u{2112}\u{211B}\u{1455}\u{1450}]))
  symbol_char = %x00-08 / %x0E-1F / %x23 / %x7F-144F / %x1451-1454 / %x1456-2111 / %x2113-211A / %x211C-10FFFF
  # read_text: Constants::PARENTHESIS[captured :paren] => match("[^close]").repeat
  read_text_0 = (1*(!(%x1450) any_char)) as literal / "" as empty_list
  read_text_1 = (1*(!(%x211B) any_char)) as literal / "" as empty_list
  read_text_2 = (1*(!(")") any_char)) as literal / "" as empty_list
  read_text_3 = (1*(!("}") any_char)) as literal / "" as empty_list
  read_text_4 = (1*(!("]") any_char)) as literal / "" as empty_list
  text_body = (%x1455 (read_text_0) as text) / (%x2112 (read_text_1) as text) / ("(" (read_text_2) as text) / ("{" (read_text_3) as text) / ("[" (read_text_4) as text)
