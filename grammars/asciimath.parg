  decimal_marker__dot = "."
  decimal_marker__comma = ","
  decimal_marker__arabic = %x66B

  # BaseNumberPrefix::Parser
  hex_number = ("0x" / "0X") ((1*(%x30-39 / %x41-46 / %x61-66)) as hex_number)
  binary_number = ("0b" / "0B") ((1*(%x30-31)) as binary_number)
  octal_number = ("0o" / "0O") ((1*(%x30-37)) as octal_number)

  # Used by the vocabulary alternation inlined in symbol_text_or_integer:
