  expression_tail__arabic = (left_right_tail__arabic) as left_right / (!ternary_classes_rules__arabic ((table__arabic) as table [power_base__arabic]) space_opt expression__arabic) as expr !any_char / ((&ternary_classes_rules__arabic / !table__arabic) iteration__arabic space_opt expression_tail__arabic) as expr / ((base) as symbol [expression__arabic]) as expr !any_char / ((power) as symbol [expression__arabic]) as expr !any_char / (1*((rparen) as rparen space_opt controversial_symbols__arabic [(comma) as comma] expression__arabic)) as expr !any_char / ((power) as symbol space_opt expression_tail__arabic) as expr / ((table__arabic) as table space_opt (rparen) as rparen space_opt [(expression__arabic) as expr] !any_char) / ([(comma) as comma] !any_char)
