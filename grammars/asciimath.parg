  # ---- measurement uncertainty (plurimath#493) ----
  # ustd(y, u) / ustd(y(d)) / uexp(y, U, k[, p]) / ucov(y, lo, hi, p[, kind]),
  # each with an optional last "unitsml(...)" argument; tree contract in
