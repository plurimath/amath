{{base_number_prefix}}

  # Used by the vocabulary alternation inlined in symbol_text_or_integer:
  # Constants.precompile_constants through hash_to_expression /
  # dynamic_parser_rules, longest word first. Parslet inlines that
  # alternation into symbol_text_or_integer (hash_to_expression is a method,
  # not a rule), and so does this grammar. Every :symbol entry is
  # (str("\\").as(:slash) >> match("\s").repeat >> str("\n")) | str(w).as(:symbol);
