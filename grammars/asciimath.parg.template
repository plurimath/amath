#
# Parslet -> PARG transcription notes
#   str("x")            "x"            .as(:n)      (X) as n
#   .maybe              [X]            .repeat(1)   1*(X)     .repeat  *(X)
#   .absent?            !(X)           .present?    &(X)
#   match(/\s+/)        space: exactly ONE char of [ \t\n\r\v\f] (Parslet's
#                       match consumes one character whatever the regexp)
#   match(/(?<!\/)\/(?!\/)/)
#                       frac_slash = "/" !"/"  (Parslet tests the regexp with
#                       StringScanner#match?, which cannot see behind the
#                       current position, so the lookbehind always passes)
#   any                 any_char
#   str("")             cannot be written in PARG. In `expression` it is the
#                       last live alternative (every alternative after it is
#                       dead and dropped here, see `expression`); it becomes
#                       [!any_char]. Where a whole `expression` is captured
#                       (td, rgb_color, the parenthesised expr) the capture is
#                       split into `(expression_nonempty) as n / "" as n`,
#                       which yields Parslet's positioned empty leaf exactly.
#   lparen.capture(:paren) + read_text
#                       text_body: one static branch per PARENTHESIS pair,
#                       "<open>" (*(!"<close>" any_char)) as text
#                       (Parslet: match("[^<close>]").repeat). No state slot:
#                       Parsanol does not memoise around state atoms, and
#                       without memoisation this grammar is exponential.
#   decimal_marker      str(Plurimath.configuration.decimal) is fixed per
#                       parser instance, so the grammar is specialised per
#                       marker: every rule that reaches decimal_marker is
#                       emitted once per marker with a __<entry> suffix and
#                       decimal_marker__<entry> is the plain literal. (A
#                       runtime `switch decimal` slot would work too, but
#                       Parsanol never memoises a composite that read state,
#                       which makes this grammar exponential.) Entries:
{{decimal_doc}}

grammar Asciimath version "0.1.0" {
  any_char = %x00-10FFFF

  # rule(:td) { expression.as(:td) }
  td = (expression_nonempty) as td / "" as td
  # rule(:base) { str("__|").absent? >> str("_") }
  base = !"__|" "_"
  power = "^"
  # rule(:space) { match(/\s+/) }  -- one character
  space = " " / "\t" / "\n" / "\r" / %x0B / %x0C
  comma = "," space_opt
  # rule(:space?) { space.maybe }
  space_opt = [space]
  number = hex_number / binary_number / octal_number / (decimal_number) as number / (".") as symbol
  decimal_number = (1*digit decimal_marker 1*digit) / 1*digit
  decimal_operand = !(hex_number / binary_number / octal_number) decimal_number
  signed_number = ("-" decimal_operand) as number
  script_operand = signed_number / sequence
  mod_operand = ("-" &(decimal_operand) iteration) as negative_mod_operand / iteration
  # Referenced by expression alternative 6, live only in tail position.
  controversial_symbols = power_base / expression
  left_right_open_paren = "(" / "["
  left_right_close_paren = ")" / "]"
  color_left_parenthesis = "(" / "[" / "{"
  color_right_parenthesis = ")" / "]" / "}"

  ternary_classes_rules = ("left" space_opt (left_right_open_paren) as left space_opt (ternary_classes power_base space_opt [(iteration) as third_value]) as ternary space_opt "right" space_opt (left_right_close_paren) as right) / (ternary_classes power_base space_opt [(iteration) as third_value]) as ternary / ternary_classes

  # arr_to_expression(Constants::TERNARY_CLASSES, :ternary_class) etc.
{{ternary_classes}}
{{binary_classes}}
{{sub_sup_classes}}
{{open_table}}
{{close_table}}
  # Constants::PARENTHESIS keys / values, in hash order.
{{lparen}}
{{rparen}}

  # rule(:left_right): its three alternatives, without the `expression`
  # that ends the second and the third; expression_chain (below) reads
  #   left_right = left_right_closed / (left_right_frac expression) / (left_right_table [expression])
  left_right_closed = "left" space_opt (left_right_open_paren) as left space_opt ([iteration] [sequence]) as left_right_value space_opt "right" space_opt (left_right_close_paren) as right
  left_right_frac = ((table) as numerator space_opt frac_slash space_opt (iteration) as denominator) as frac
  left_right_table = (table) as table [power_base]

  # The third alternative is str('"') >> str("").as(:text).
  quoted_text = ("\"" "unitsml(" (*(!")\"" any_char)) as unitsml ")\"") / ("\"" (*(!"\"" any_char)) as text "\"") / ("\"" "" as text)

  symbol_text_or_integer = uncertainty / sub_sup_classes / binary_classes / ternary_classes / {{vocabulary}} / (1*((digit) as number !(decimal_marker digit) (",") as comma)) as comma_separated / quoted_text / (("d") as d ("x") as x) as intermediate_exp / (!"left" !"right" (ascii_letter) as symbol) / (symbol_char) as symbol / number

  power_base = (base space_opt (script_operand) as base_value power !(power [power]) space_opt (script_operand) as power_value) / (space_opt base space_opt (script_operand) as base_value) as base / (space_opt power !(power [power]) space_opt (script_operand) as power_value) as power / (space_opt base space_opt ((power) as symbol) as base_value) as base / (space_opt power !(power [power]) space_opt ((base) as symbol) as power_value) as power

  power_base_rules = (sub_sup_classes power_base) as power_base / (binary_classes space_opt [(sequence) as base_value] space_opt [(sequence) as power_value]) as power_base / ((sequence) as power_base power_base) as power_base

  table = (("{") as table_left space_opt tr space_opt (close_table) as table_right) / ((open_table) as table_left space_opt tr space_opt (close_table) as table_right) / (("norm") as norm (open_table) as table_left space_opt tr space_opt (close_table) as table_right) / (("|") as table_left space_opt tr space_opt ("|") as table_right) / ("left" space_opt (left_right_open_paren) as left space_opt tr space_opt "right" space_opt (left_right_close_paren) as right)

  tr = (((left_right_open_paren) as open_tr (td) as tds_list left_right_close_paren) as table_row space_opt comma space_opt (tr) as expr) / ((left_right_open_paren) as open_tr (td) as tds_list left_right_close_paren) as table_row

  # color_left_parenthesis.capture(:paren) is not transcribed: the only
  # reader of :paren is read_text, and `text` always sets it immediately
  # before, so the capture is unobservable; a state write here would only
  # disable Parsanol's memoisation around every colour argument.
  color_value = ((color_left_parenthesis) as lparen ((expression_nonempty) as rgb_color / "" as rgb_color) [color_right_parenthesis] as rparen) as intermediate_exp / iteration

  sequence = ((lparen) as lparen space_opt ((expression_nonempty) as expr / "" as expr) space_opt [rparen] as rparen) as intermediate_exp / ("text" text_body [rparen]) as intermediate_exp / symbol_text_or_integer

  frac = ((sequence) as numerator space_opt frac_slash space_opt (iteration) as denominator) as frac / ((power_base_rules / power_base) as numerator space_opt frac_slash space_opt (iteration) as denominator) as frac

  mod = ((sequence) as dividend space_opt ("mod") as mod space_opt (mod_operand) as divisor) as mod / ((power_base_rules power_base) as dividend space_opt ("mod") as mod space_opt (mod_operand) as divisor) as mod / ((power_base_rules) as dividend space_opt ("mod") as mod space_opt (mod_operand) as divisor) as mod

  iteration = ternary_classes_rules / ((table) as table [power_base]) / (comma) as comma / mod / ((sequence) as sequence space_opt ("//") as symbol) / ("color" (color_value) as color (sequence) as color_value) / frac / (power_base_rules power_base) / power_base_rules / (sequence) as sequence / space

  # Oracle alternatives, in order:
  #   1 left_right.as(:left_right)
  #   2 (iteration >> space? >> expression).as(:expr)
  #   3 (base.as(:symbol) >> expression.maybe).as(:expr)
  #   4 (power.as(:symbol) >> expression.maybe).as(:expr)
  #   5 str("")                      -> [!any_char] (always matches empty)
  #   6 (rparen.as(:rparen) >> space? >> controversial_symbols >> comma.as(:comma).maybe >> expression).repeat(1).as(:expr)
  #   7 (power.as(:symbol) >> space? >> expression).as(:expr)
  #   8 (table.as(:table) >> space? >> rparen.as(:rparen) >> space? >> expression.as(:expr).maybe)
  #   9 comma.as(:comma).maybe
  # Away from the parse root, 6-9 follow an always-succeeding alternative and
  # can never match: dropped here (see expression_tail for the root).
  expression = expression_nonempty / [!any_char]
  #
  # Flattened chains. Written as in the oracle, alternatives 1-4 are right
  # recursive (alternative 1 through left_right, whose second and third
  # alternatives end in `expression`): a sum of N terms nests about 2N
  # rule calls deep, past the native engine's recursion limit at about 200
  # terms and past a 1 MiB Ruby stack soon after. Away from the root
  # `expression` cannot fail, so once one of these alternatives has matched
  # its first part (left_right_frac, left_right_table, iteration and
  # space_opt, base, or power) it never backtracks: the rule is the loop
  # "while left_right_closed does not match here and one of those first
  # parts does (in that order), consume it; then take left_right_closed or
  # nothing". expression_chain is that loop as a repetition. It tags each
  # first part `amath_lr` (left_right's) or `amath_step` (alternatives
  # 2-4) and the closing left_right_closed `amath_end`, all inside one
  # `amath_chain` node; Amath::Renester rebuilds the oracle's nested tree
  # from it ({left_right: part + rest} or {expr: part + rest} per part),
  # without recursion, merging the parts exactly as the parser merges
  # sequence results. The chain needs at least one part, so its node is a
  # Hash wherever the oracle's result is one; with no part, alternative 1
  # can only be left_right_closed.
  expression_nonempty = expression_chain / (left_right_closed) as left_right
  # The chain node sits under the key the oracle's outermost level has
  # (:left_right when the first part is left_right's, else :expr), so a
  # sequence merging this result with a sibling keeps or drops exactly the
  # keys the oracle's merge does; a bare :amath_chain key would collide
  # between two chains where the oracle's keys differ.
  expression_chain = (&(!left_right_closed (left_right_frac / left_right_table)) expression_chain_body) as left_right / (expression_chain_body) as expr
  expression_chain_body = (1*(expression_link) [((left_right_closed) as left_right) as amath_end]) as amath_chain
  expression_link = !left_right_closed ((left_right_frac / left_right_table) as amath_lr / (iteration space_opt) as amath_step / ((base) as symbol) as amath_step / ((power) as symbol) as amath_step)

  # Parslet's parse(input) applies the root with consume_all = true, and
  # consume_all propagates: Alternative passes it to every alternative,
  # Sequence to its last element, Named/Entity unchanged; a repetition,
  # maybe or terminal in that position runs normally and must then sit at
  # end of input, or it FAILS (so the alternative after it is tried). In
  # that tail position str("") only matches at end of input, and the
  # alternatives 6-9 after it are live. Only expression and left_right are
  # reached in tail position, so each gets a _tail variant; the entry points
  # use expression_tail. Alternative 5 (str("") at end) and 9 (comma.maybe
  # at end) both match only the empty rest of input, where 6-8 cannot match,
  # so 5 is folded into 9, the last branch.
  # Parslet's packrat cache keys on atom and position, NOT on consume_all,
  # so a tail-position `expression` at a position where a non-tail
  # `expression` already ran reuses that non-tail result and then fails the
  # end-of-input check. One collision is reproduced: whenever `table`
  # matches at a tail position, left_right_tail's third alternative has
  # already run a non-tail [expression] right after `table [power_base]`;
  # so when alternative 2 then takes iteration's table branch (ternary
  # failed, table matched), the expression after it behaves as a non-tail
  # expression that must reach end of input (alternative 2a below), and
  # iteration's other branches keep the true tail rule (2b). Other
  # collisions (e.g. two or more spaces after the table) are not emulated.
  #
  # expression_tail_rec is the rule described above, unchanged (its own
  # recursion included). Its first alternative (through left_right_tail's
  # second) and its third recurse once per term, and unlike `expression`
  # they can fail and backtrack: when the rest of the input does not parse,
  # the next alternatives are tried at the same position.
  # expression_tail first tries expression_tail_chain, which follows those
  # two recursions as a loop. At each position, in the rule's order: where
  # left_right_tail_closed matches, the loop stops; where left_right_frac
  # matches, it consumes it (`amath_lr`); otherwise, where neither
  # left_right_tail_table nor expression_tail_table matches and the third
  # alternative's first part does, it consumes that part (`amath_step`).
  # Where the loop stops, it takes the first two alternatives
  # (expression_tail_head) or 4-9 (expression_tail_rest). Whenever the
  # chain matches, expression_tail_rec matches the same text with the same
  # tree: each recursive alternative it takes succeeds on the next
  # position's result, which the chain already found, and every
  # alternative before it fails there. When the chain fails, the input
  # needs a backtrack (or is rejected), and expression_tail_rec parses it
  # exactly as before, recursively. Alternative 7 (power, then
  # expression_tail) is not looped: it runs only after alternatives 3-6
  # failed at the same position, and nests one level per such power sign.
  expression_tail = expression_tail_chain / expression_tail_rec
  # Keyed by its first part as expression_chain is.
  expression_tail_chain = (&(!left_right_tail_closed left_right_frac) expression_tail_chain_body) as left_right / (expression_tail_chain_body) as expr
  expression_tail_chain_body = (1*(expression_tail_link) (expression_tail_head / expression_tail_rest) as amath_end) as amath_chain
  expression_tail_link = !left_right_tail_closed ((left_right_frac) as amath_lr / !(left_right_tail_table / expression_tail_table) ((&ternary_classes_rules / !table) iteration space_opt) as amath_step)
  expression_tail_head = (left_right_tail) as left_right / expression_tail_table
  expression_tail_table = (!ternary_classes_rules ((table) as table [power_base]) space_opt expression) as expr !any_char
  expression_tail_rest = ((base) as symbol [expression]) as expr !any_char / ((power) as symbol [expression]) as expr !any_char / (1*((rparen) as rparen space_opt controversial_symbols [(comma) as comma] expression)) as expr !any_char / ((power) as symbol space_opt expression_tail) as expr / ((table) as table space_opt (rparen) as rparen space_opt [(expression) as expr] !any_char) / ([(comma) as comma] !any_char)
  left_right_tail = left_right_tail_closed / (left_right_frac expression_tail) / left_right_tail_table
  left_right_tail_closed = left_right_closed !any_char
  left_right_tail_table = left_right_table [expression] !any_char
  expression_tail_rec = (left_right_tail_rec) as left_right / (!ternary_classes_rules ((table) as table [power_base]) space_opt expression) as expr !any_char / ((&ternary_classes_rules / !table) iteration space_opt expression_tail_rec) as expr / ((base) as symbol [expression]) as expr !any_char / ((power) as symbol [expression]) as expr !any_char / (1*((rparen) as rparen space_opt controversial_symbols [(comma) as comma] expression)) as expr !any_char / ((power) as symbol space_opt expression_tail_rec) as expr / ((table) as table space_opt (rparen) as rparen space_opt [(expression) as expr] !any_char) / ([(comma) as comma] !any_char)
  left_right_tail_rec = ("left" space_opt (left_right_open_paren) as left space_opt ([iteration] [sequence]) as left_right_value space_opt "right" space_opt (left_right_close_paren) as right !any_char) / (((table) as numerator space_opt frac_slash space_opt (iteration) as denominator) as frac expression_tail_rec) / ((table) as table [power_base] [expression] !any_char)

  # ---- measurement uncertainty (plurimath#493) ----
  # ustd(y, u) / ustd(y(d)) / uexp(y, U, k[, p]) / ucov(y, lo, hi, p[, kind]),
  # each with an optional last "unitsml(...)" argument; tree contract in
  # plurimath docs/uncertainty-asciimath-tree.md. `uncertainty` is the first
  # alternative of symbol_text_or_integer, so a well-formed `uexp(...)` no
  # longer reads as `u exp(...)`. A call that is not a well-formed uncertainty form (e.g. uexp
  # with two arguments, or uexp(x)) fails here and falls back to the
  # ordinary alternatives, so it parses as letters exactly as before.
  # Numbers always use a full stop, whatever the decimal marker.
  unc_number = 1*digit ["." 1*digit]
  unc_value = (["-"] unc_number) as value
  unc_sep = *space "," *space
  unc_unit = unc_sep "\"unitsml(" (*(!")\"" any_char)) as unit ")\""
  unc_open = "(" *space
  unc_close = *space ")"
  uncertainty = (uncertainty_std / uncertainty_exp / uncertainty_cov) as uncertainty
  uncertainty_std = ("ustd") as uncertainty_class unc_open unc_value (unc_sep (unc_number) as magnitude / "(" (1*digit) as concise_digits ")") [unc_unit] unc_close
  uncertainty_exp = ("uexp") as uncertainty_class unc_open unc_value unc_sep (unc_number) as magnitude unc_sep (unc_number) as coverage_factor [unc_sep (unc_number) as coverage_probability] [unc_unit] unc_close
  uncertainty_cov = ("ucov") as uncertainty_class unc_open unc_value unc_sep (unc_number) as lower unc_sep (unc_number) as upper unc_sep (unc_number) as coverage_probability [unc_sep ("shortest" / "symmetric") as interval_kind] [unc_unit] unc_close

  # ---- helpers (no Parslet rule of their own) ----
  digit = %x30-39
  ascii_letter = %x41-5A / %x61-7A
  # match(/(?<!\/)\/(?!\/)/), see the notes above.
  frac_slash = "/" !"/"
{{symbol_char}}
{{read_text}}
{{decimal_marker}}

