ternative":{"atoms":[91,88,84]}},{"Sequence":{"atoms":[0,1]}}],"root":93},"bindings":[]}},"preprocess":{},"tables":{},"lint":{"order_warnings":["rule decimal_number: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule symbol: branches 1 and 2 are order-dependent (shared first bytes; ordered choice is decisive)","rule sequence: branches 1 and 4 are order-dependent (shared first bytes; ordered choice is decisive)","rule sequence: branches 2 and 4 are order-dependent (shared first bytes; ordered choice is decisive)","rule expression: branches 1 and 3 are order-dependent (first set not statically known)","rule expression: branches 2 and 3 are order-dependent (first set not statically known)"]},"default_entry":null,"render":{},"derive":{},"tests":[],"docs":{},"source":"# A0 feasibility spike: the four non-static constructs of Plurimath's\n# AsciiMath grammar (oracle ae20be11, lib/plurimath/asciimath/parse.rb).\n\ngrammar AmathSpike version \"0.0.1\" {\n  any_char = %x00-10FFFF\n  space = 1*(\" \" / \"\\t\" / \"\\n\" / \"\\r\" / %x0B / %x0C)\n  lparen = \"(\" / \"{\" / \"[\" / \"ᑕ\" / \"ℒ\"\n  rparen = \")\" / \"}\" / \"]\" / \"ᑐ\" / \"ℛ\"\n  digit = %x30-39\n  digits = 1*digit\n  m_dot = \".\"\n  m_comma = \",\"\n  m_arabic = \"٫\"\n  marker = switch decimal { \",\" -> m_comma \"٫\" -> m_arabic _ -> m_dot }\n  decimal_number = (digits marker digits) / digits\n  tb_rp = *(!\")\" any_char)\n  tb_rc = *(!\"}\" any_char)\n  tb_rb = *(!\"]\" any_char)\n  tb_c1 = *(!\"ᑐ\" any_char)\n  tb_c2 = *(!\"ℛ\" any_char)\n  text_body = switch paren { \"(\" -> tb_rp \"{\" -> tb_rc \"[\" -> tb_rb \"ᑕ\" -> tb_c1 \"ℒ\" -> tb_c2 }\n  text = (\"text\" set paren = (lparen) (text_body) as text [rparen]) as intermediate_exp\n  unary_word = (\"sinh\" / \"sin\") as unary_class\n  unary = (unary_word [space] [sequence]) as unary\n  vocab_symbol = (\"alpha\" / \"al\") as symbol\n  symbol = vocab_symbol / (%x61-7A) as symbol\n  sequence = text / unary / (decimal_number) as number / symbol\n  expression = ((sequence) as sequence [space] expression) as expr / ((\"_\") as symbol [expression]) as expr / [!any_char]\n  root_dot = set decimal = \".\" expression\n  root_comma = set decimal = \",\" expression\n  root_arabic = set decimal = \"٫\" expression\n}\n\nentry dot: root_dot\nentry comma: root_comma\nentry arabic: root_arabic\n","source_hash":"b4850481eb45a0de009cc698532883c3c66571f94cfa0b353d913ca12cf5fcc4","compiler_version":"1.3.107","dynamic":true,"checksum":"sha256:187144fd911281ec38e476603e7472e5714a7e52a0cbf2137a23f1b95c1d831a"}
